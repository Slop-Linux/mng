# Linux (aarch64, Vulkan) runtime of Ocarina of Time (Switch 2): make -f Makefile.linux, inside `nix develop`.
# The same Linux layer as games/totk (runtime/linux is a link to it): Darwin shims (force-included darwin_compat.h), the
# SDL3 frontend and the Vulkan backend, compiled against this game's own runtime and NVN headers.
CC := clang
OUT = build/linux-oot$(if $(filter null,$(GFX)),-null)
DEFS := -DGAME_OOT=1 -DGAME_NS2=1
OPT ?= -O2
PKGS := opus vpx sdl3 vulkan openssl dav1d
CFLAGS = -std=gnu11 $(OPT) -g -Wall -Wextra -Wno-unused-parameter -Wno-unused-function -Wno-missing-field-initializers -Wno-sign-compare \
  -fno-strict-aliasing -D_GNU_SOURCE $(DEFS) $(BACKEND) -Iruntime/linux/include -include darwin_compat.h -Ithird_party/d2r_gfx/gfx/nvn/include -Ithird_party -I. -Ibuild \
  $(shell pkg-config --cflags $(PKGS)) -I$(shell pkg-config --variable=includedir opus)/opus
LIBS := $(shell pkg-config --libs $(PKGS)) -lpthread -lm -ldl
RUNTIME := loader game_data game_patches_ns2 ns2_host ns2_codec hle_movie_av1 ns2_audio_out ns2_opus_ms offline_host world_survey \
  game_slot services romfs threads hle_stack gfx_bridge account input hid_feedback motion_fusion autoload gfx_probe memory_probe \
  shared_font ipc audio_renderer audio_mixer audio_reverb audio_effects fs_host opus_codec movie_host time_host applet_host swkbd_host
RUNTIME_ASM := gate hle_stack thread_enter
# GFX=vk (default): the Vulkan backend (runtime/linux/vk); GFX=null: no GPU work (runtime/linux/gfx_null.c)
GFX ?= vk
LINUX := darwin_shim frontend gamepad gfx_null
ifeq ($(GFX),vk)
LINUX += vk/vk_dev vk/vk_tex vk/vk_shader vk/vk_replay vk/vk_fbread vk/vk_retype vk/vk_pool
BACKEND := -DVK_BACKEND=1
endif
NVN_SRC := hle_nvn nvn_dirty nvn_tex totk_lifelog totk_nvn_ext totk_sysload totk_timeline totk_vpool
GFX_ASM := nvn_entry nvn_thunks
TEX := nvn_bcdec nvn_deswizzle
VR := totk_vr_link vr_defaults
OBJS := $(RUNTIME:%=$(OUT)/runtime/%.o) $(RUNTIME_ASM:%=$(OUT)/runtime/%.S.o) $(LINUX:%=$(OUT)/linux/%.o) \
  $(NVN_SRC:%=$(OUT)/gfx/%.o) $(GFX_ASM:%=$(OUT)/gfx/%.S.o) $(TEX:%=$(OUT)/tex/%.o) $(VR:%=$(OUT)/vr/%.o)
HEADERS := $(wildcard zeldaVR/gfx/*.h zeldaVR/runtime/*.h runtime/*.h runtime/linux/*.h runtime/linux/vk/*.h runtime/linux/include/*.h runtime/linux/include/*/*.h third_party/d2r_gfx/gfx/nvn/*.h third_party/d2r_gfx/gfx/nvn/include/*.h third_party/d2r_gfx/host/*.h)

$(OUT)/oot-native: $(OBJS)
	$(CC) $(OBJS) $(LIBS) -o $@
$(OUT)/runtime/%.o: runtime/%.c $(HEADERS) Makefile.linux
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@
$(OUT)/runtime/%.S.o: runtime/%.S third_party/d2r_gfx/gfx/nvn/include/asm_sym.h
	@mkdir -p $(dir $@)
	$(CC) -Ithird_party/d2r_gfx/gfx/nvn/include -c $< -o $@
$(OUT)/linux/%.o: runtime/linux/%.c $(HEADERS) Makefile.linux
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -Iruntime -c $< -o $@
$(OUT)/gfx/%.o: third_party/d2r_gfx/gfx/nvn/%.c $(HEADERS) Makefile.linux
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@
$(OUT)/gfx/%.S.o: third_party/d2r_gfx/gfx/nvn/%.S third_party/d2r_gfx/gfx/nvn/include/asm_sym.h
	@mkdir -p $(dir $@)
	$(CC) -Ithird_party/d2r_gfx/gfx/nvn/include -c $< -o $@
$(OUT)/tex/%.o: third_party/d2r_gfx/gfx/tex/%.c $(HEADERS) Makefile.linux
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@
$(OUT)/vr/%.o: zeldaVR/gfx/%.c $(HEADERS) Makefile.linux
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@
# the GPU deswizzle (vk_tex.c upload): SPIR-V as a C array
build/deswizzle_spv.h: runtime/linux/vk/deswizzle.comp
	@mkdir -p build
	glslangValidator -V --target-env vulkan1.3 --vn deswizzle_spv $< -o $@
$(OUT)/linux/vk/vk_tex.o: build/deswizzle_spv.h
